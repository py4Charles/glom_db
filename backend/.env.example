# Copy to .env and fill in. Keep this file out of version control and out of the
# frontend bundle. Never prefix a secret with VITE_: Vite exposes VITE_-prefixed
# variables to the browser, and config.js refuses to boot if you do.

# ---------------------------------------------------------------- database
# Hosted Supabase Postgres. Dashboard -> Connect -> Connection string.
#
# Three things are not optional here:
#   1. An SSL mode. Supavisor rejects plaintext connections, and node-postgres
#      sends no SSL negotiation at all unless the mode says so.
#   2. sslmode=no-verify is what actually works against Supavisor. The
#      alternative, sslmode=require, fails with SELF_SIGNED_CERT_IN_CHAIN,
#      because Supavisor terminates TLS with a certificate this machine does not
#      trust. no-verify still encrypts the traffic; it just skips verifying that
#      the certificate belongs to Supabase, which leaves a theoretical
#      man-in-the-middle window. Prefer verify-full once the root CA for
#      Supavisor is available via PGSSLROOTCERT.
#   3. The database name is `postgres`, not `members` -- every hosted Supabase
#      project uses `postgres` regardless of what you called it locally.
#
# Use the SESSION pooler (port 5432) on aws-0-<region>.pooler.supabase.com, not
# the direct db.<ref>.supabase.co host: direct connections resolve to IPv6 only
# on the free and paid tiers, and most networks are not IPv6-capable. The
# username gains a ".<project-ref>" suffix when going through the pooler, and
# omitting it fails with ENOIDENTIFIER rather than a credentials error.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# ------------------------------------------------------------------- auth
# 'dev' disables authentication so the app runs without a Supabase auth server.
# The server prints a warning and refuses to start if this is left on with
# NODE_ENV=production. Switch to 'supabase' once Docker or a hosted project is
# available.
AUTH_MODE=dev

# Only needed when AUTH_MODE=supabase. Both values come from your hosted
# project's API settings. The service role key is deliberately NOT here: it is
# an HTTP bearer token for the PostgREST Data API, not a Postgres credential,
# and this app talks to Postgres with pg.
SUPABASE_URL=
SUPABASE_ANON_KEY=

PORT=3001
